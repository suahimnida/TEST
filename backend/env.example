# 이 파일을 복사해서 backend/.env로 저장한 뒤 값을 채운다.
# .env는 .gitignore에 들어 있으므로 커밋되지 않는다. 키를 이 예시 파일에 쓰지 말 것.

# KISA 블랙리스트 (urls.json, hosts.json이 있는 폴더). 비우면 프로젝트 루트 사용
BLACKLIST_DIR=

# 분석 기록을 저장할 PostgreSQL 연결 문자열 (Neon, Supabase 등).
# 비우면 아래 DB_PATH의 SQLite 파일을 쓴다. Render 배포에서는 반드시 채워야 기록이 유지된다
DATABASE_URL=
# SQLite DB 파일 경로. 비우면 backend/data/analyses.db 사용
DB_PATH=

# 요청을 허용할 프론트 주소. 쉼표로 여러 개 지정. 비우면 http://localhost:5173 사용
CORS_ORIGINS=

# RAG
# Claude API 키. 비우면 RAG가 꺼진 상태로 서버가 실행된다
ANTHROPIC_API_KEY=
# 벡터 스토어 폴더 (phishing_index.faiss, metadata.jsonl). 비우면 codes/vector_store 사용
RAG_INDEX_DIR=
# 검색할 유사 사례 개수. 비우면 5
RAG_TOP_K=
